 "ranges": {
  "text": "Reading and Writing and Math are each scored 160 to 760, the total is the sum of the two section scores, 320 to 1520, and the NMSC Selection Index is twice Reading and Writing plus Math, over 10, 48 to 228",
  "src": "College Board",
  "year": 2026,
  "url": "https://satsuite.collegeboard.org/media/pdf/psat-nmsqt-understanding-scores.pdf",
  "title": "Fall 2026 PSAT/NMSQT Understanding Scores"
 },
 "selection_index": {
  "text": "Your score is calculated by doubling your Reading and Writing Score, adding it to your Math score, then dividing that sum by 10.",
  "scale": "48 to 228",
  "src": "College Board",
  "year": 2026,
  "url": "https://satsuite.collegeboard.org/scores/what-scores-mean",
  "title": "What Do My Scores Mean?"
 },
 "all_tester": {
  "text": "All Tester Percentiles are based on the actual scores of the past 3 cohorts of students who took the PSAT/NMSQT in 10th or 11th grade, for tests completed anywhere in the world. Students in 10th grade are provided the 10th-grade percentile, and students in 11th grade are provided the 11th-grade percentile.",
  "src": "College Board",
  "year": 2026,
  "url": "https://satsuite.collegeboard.org/media/pdf/psat-nmsqt-understanding-scores.pdf",
  "title": "Fall 2026 PSAT/NMSQT Understanding Scores"
 },
